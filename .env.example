# Local: run `npm run db:start` (embedded Postgres) and use this URL.
# Production (Railway): set to the Postgres service's connection URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cuemanager"

# Random string, at least 32 characters. Changing it logs everyone out and unpairs all tablets.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_PASSWORD="change-me-to-a-random-string-of-at-least-32-chars"

# Required to create the first organiser account at /setup. Keep it secret; anyone with it can claim
# a fresh install. Not needed once your account exists.
SETUP_KEY="change-me"

# Optional: the name shown in the header and page titles.
# NEXT_PUBLIC_APP_NAME="Cue Comp"

# Optional: the site's own domain; visits to the *.onrender.com address redirect here.
# SITE_HOST="cuecomp.app"

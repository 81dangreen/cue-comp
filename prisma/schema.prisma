// CueScore-style competition management.
// Postgres everywhere: embedded locally (`npm run db:start`), managed on Railway in production.
// String columns are used instead of enums so the schema stays portable —
// allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  players     Player[]
  venues      Venue[]
  tournaments Tournament[]
  devices     Device[]
  invites     Invite[]
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  passwordHash   String
  // Central admin of the shared player directory: edits players, contact details and ranks for everyone.
  directoryAdmin Boolean         @default(false)
  // Bumped when the password changes, which signs out every other session.
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now())
  memberships    Membership[]
  passwordResets PasswordReset[]
}

// A link that adds someone to an organisation with a role. Only the token's hash is stored.
model Invite {
  id             String       @id @default(cuid())
  organizationId String
  tokenHash      String       @unique
  role           String // ADMIN | SCORER
  // Who it's for, so pending invites can be told apart (optional).
  label          String?
  createdById    String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// A one-time link to set a new password, created by an organiser for a team member.
model PasswordReset {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("ADMIN") // OWNER | ADMIN | SCORER
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// The shared player directory: one record per person across every organiser and venue.
// Records, contact details and ranks are managed by directory admins (User.directoryAdmin).
model Player {
  id             String        @id @default(cuid())
  // Organisation that first added the player (for reference only; players aren't owned by it).
  organizationId String?
  firstName      String
  lastName       String
  nickname       String?
  email          String?
  phone          String?
  country        String?
  homeClub       String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  entries        Entry[]
  partnerEntries Entry[]       @relation("EntryPartner")
  ranks          PlayerRank[]

  @@index([lastName, firstName])
}

model Venue {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables         Table[]
  tournaments    Tournament[]
}

model Table {
  id               String    @id @default(cuid())
  venueId          String
  name             String
  sortOrder        Int       @default(0)
  streamUrl        String?
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matches          Match[]
  groups           Group[]
  // One-time code a tablet enters (or scans) to become this table's scoreboard.
  pairingCode      String?   @unique
  pairingExpiresAt DateTime?
  devices          Device[]
}

model Tournament {
  id                 String       @id @default(cuid())
  organizationId     String
  venueId            String?
  name               String
  slug               String       @unique
  description        String?
  discipline         String       @default("EIGHT_BALL")
  format             String       @default("SINGLE_ELIM") // SINGLE_ELIM | DOUBLE_ELIM | ROUND_ROBIN | GROUPS_KO
  raceTo             Int          @default(5)
  raceToFinal        Int?
  maxEntries         Int?
  entryFee           String?
  startsAt           DateTime?
  status             String       @default("DRAFT") // DRAFT | REGISTRATION | IN_PROGRESS | COMPLETED
  registrationOpen   Boolean      @default(false)
  isPublic           Boolean      @default(true)
  seeding            String       @default("RANDOM") // RANDOM | MANUAL
  groupCount         Int?
  qualifiersPerGroup Int?
  grandFinalReset    Boolean      @default(true)
  // Auto-pilot: assign the next ready match whenever a table frees up.
  autoAssignTables   Boolean      @default(false)
  // Handicap: null = level play, else HEAD_START | MINUS_START | LONGER_RACE (see src/lib/handicap.ts).
  handicapStyle      String?
  // Start per rank gap: [gap 1, gap 2, ...]; the last value covers larger gaps.
  handicapStarts     Int[]        @default([])
  // Optional start per pairing of ranks, e.g. {"1-2": 1, "1-3": 3}; replaces the gap table when set.
  handicapMatrix     Json?
  // SINGLES | PAIRS (an entry is two players).
  entryType          String       @default("SINGLES")
  // Frame-list matches (pairs): D = doubles, AA/BB/AB/BA = singles between each pair's Player A/B.
  // Empty = a plain race to raceTo. See src/lib/match-format.ts.
  matchFrames        String[]     @default([])
  groupFinish        String       @default("FIRST_TO") // FIRST_TO | ALL
  koFinish           String       @default("FIRST_TO") // FIRST_TO | ALL (level knockouts play a doubles decider)
  lineupMode         String       @default("RANDOM") // RANDOM | PICK_MATCH | PICK_FRAME
  // Who breaks after the first rack: ALTERNATE | WINNER (see src/lib/breaks.ts).
  breakRule          String       @default("ALTERNATE")
  // Group tables: points per result, then tiebreakers in order (see src/lib/standings.ts).
  pointsWin          Int          @default(2)
  pointsDraw         Int          @default(1)
  pointsLoss         Int          @default(0)
  tiebreakers        String[]     @default(["FRAME_DIFF", "FRAMES_FOR", "HEAD_TO_HEAD"])
  // Group finishers after the main qualifiers who go into a plate bracket (per group).
  plateQualifiers    Int?
  // Give each group its own table at the venue; auto-pilot keeps the group's matches there.
  tablePerGroup      Boolean      @default(false)
  // Expected minutes per frame: the baseline the timings page measures the comp against.
  frameMinutes       Int          @default(15)
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venue              Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  entries            Entry[]
  groups             Group[]
  matches            Match[]

  @@index([organizationId, startsAt])
}

model Entry {
  id           String     @id @default(cuid())
  tournamentId String
  playerId     String
  // Second player of a pair (pairs comps).
  partnerId    String?
  teamName     String?
  seed         Int?
  status       String     @default("CONFIRMED") // REGISTERED | CONFIRMED | WITHDRAWN
  groupId      String?
  finalRank    Int?
  // Handicap rank for this comp (1 = strongest). Frozen from the player's rank when the draw is made;
  // an organiser can override it for this comp only without touching the player's ranking.
  rank         Int?
  // Contact details given when the player registered for this comp, for its organisers.
  contactEmail String?
  contactPhone String?
  // Shootout order entered by the organiser to split a tie in the group table (lower is better).
  tiebreak     Int?
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  partner      Player?    @relation("EntryPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, playerId])
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  index        Int
  // The group's own table, when the tournament gives each group one.
  tableId      String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  table        Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  entries      Entry[]
  matches      Match[]
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  // WINNERS (also used for single elim) | LOSERS | FINAL | GROUP
  bracket      String
  round        Int
  position     Int
  code         String // human label, e.g. "W1-3", "L2-1", "GF", "A-4"
  groupId      String?
  raceTo       Int
  entry1Id     String?
  entry2Id     String?
  score1       Int        @default(0)
  score2       Int        @default(0)
  winnerId     String?
  // PENDING (waiting for players) | READY | LIVE | COMPLETED | VOID (bye / unused reset)
  status       String     @default("PENDING")
  // A bye match: one side will never be filled, so whoever arrives advances.
  isBye        Boolean    @default(false)
  // Given by the organiser without being played (no-show). Scores are 0-0, or the full score if chosen.
  walkover     Boolean    @default(false)
  // Where the winner / loser goes next. Slot is 1 or 2.
  winnerToId   String?
  winnerToSlot Int?
  loserToId    String?
  loserToSlot  Int?
  tableId      String?
  // When the match was sent to its current table (for the time players take to start).
  calledAt     DateTime?
  startedAt    DateTime?
  breakSlot    Int? // who broke first (1 or 2)
  // Handicap fixed when the match starts: starting scores, and per-side race targets (null = raceTo).
  handicap1    Int        @default(0)
  handicap2    Int        @default(0)
  target1      Int?
  target2      Int?
  // Frame-list matches: each pair's Player A and B ({"1":{"A":playerId,"B":playerId},"2":{...}}).
  lineup       Json?
  completedAt  DateTime?
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  table        Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  frames       Frame[]

  @@index([tournamentId, bracket, round, position])
}

// One record per rack/frame won, so scores have history and can be undone.
model Frame {
  id          String   @id @default(cuid())
  matchId     String
  number      Int
  winner      Int // 1 or 2
  breakAndRun Boolean  @default(false)
  // The player who didn't break cleared the table on their first visit.
  reverseDish Boolean  @default(false)
  // Frame-list matches: who played a singles frame for each side (null in doubles).
  player1Id   String?
  player2Id   String?
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, number])
}

// A tablet paired to a table. It can only score matches assigned to that table.
// Deleting the row revokes it: its cookie stops working on the next request.
model Device {
  id             String       @id @default(cuid())
  organizationId String
  tableId        String
  name           String
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  table          Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
}

// A player's handicap rank in one discipline (1 = strongest).
model PlayerRank {
  id         String @id @default(cuid())
  playerId   String
  discipline String
  rank       Int
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, discipline])
}
